# -- Container Configuratie --
NETWORK_NAME=es-run-net
LOGSTASH_CONTAINER_NAME=es-run-logstash
LISTENER_CONTAINER_NAME=es-run-listener
LISTENER_IMAGE_NAME=es-run-listener-img

# -- Netwerk Poorten --
LOGSTASH_PORT=8080
LISTENER_PORT=8081

# -- Logstash JVM & Worker Instellingen --
LOGSTASH_HEAP_SIZE=4g
# Laat leeg om automatisch CPU-kernen te detecteren
LOGSTASH_PIPELINE_WORKERS=